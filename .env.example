# Postgres. Two options:
#  - Local, no account or Docker: run `npm run db` (embedded Postgres 17 on
#    port 5433, data in ./.pgdata) and use the localhost URLs below.
#  - Neon (free tier, used in production — use a dev branch locally).
#    DATABASE_URL: pooled connection string (host contains "-pooler").
#    DIRECT_URL:   direct connection string, used by `prisma migrate`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/covercraft"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/covercraft"

# Signs session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL, no trailing slash. OAuth callback URLs, the sitemap and
# metadata are built from it. Falls back to the request origin when empty.
APP_URL="http://localhost:3000"

# Google sign-in (optional). Both values needed, or the button stays disabled.
# Callback URL to register: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub sign-in (optional). Both values needed, or the button stays disabled.
# Callback URL to register: ${APP_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (test mode). Get these from the Stripe dashboard / `stripe listen`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Optional — without this, /api/generate returns a labeled demo letter
# instead of calling the API, so the app runs fully without a key.
ANTHROPIC_API_KEY=""
